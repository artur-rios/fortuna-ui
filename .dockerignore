# Only what `flutter build web` reads goes into the build context:
# pubspec.*, lib/, web/, packages/ and the Docker files.
# native/ holds the FFI core headers for desktop offline mode; the web
# build resolves dart:ffi imports to their unsupported stubs instead.

.git
.github
.gitignore
.gitattributes
.idea
.vscode
*.iml
.DS_Store

# Build outputs and local tool state
build
**/build
.dart_tool
**/.dart_tool
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache
.pub
coverage

# Platforms other than web
android
ios
linux
macos
windows

# Not needed to compile the app
docs
test
**/test
integration_test
tool
api
swagger_parser.yaml
config/local.json
*.log

# The image recipe itself
Dockerfile
.dockerignore

# Desktop-only FFI core and its binding generator config
native
ffigen.yaml
